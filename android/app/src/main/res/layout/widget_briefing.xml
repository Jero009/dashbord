<?xml version="1.0" encoding="utf-8"?>
<!-- Minimalist briefing widget (classic skin): the VU verdict bar is the
     hero, next to ONE verdict word (GO / OK / REST / SICK / DELOAD) and the
     date. No title, no body text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Glyph-LED verdict bar: 3 SQUARE segments (20dp, uniform size, 3dp
         gaps) in a 66dp column — the widget's focal point. Order top→bottom
         is green, yellow, red; BriefingWidgetProvider paints by level. -->
    <LinearLayout
        android:id="@+id/widget_vu_bar"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:layout_marginEnd="18dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_vu_green"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_vu_seg_dim" />

        <TextView
            android:id="@+id/widget_vu_yellow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_vu_seg_dim" />

        <TextView
            android:id="@+id/widget_vu_red"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_vu_seg_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_briefing_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />

        <TextView
            android:id="@+id/widget_briefing_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/space_grotesk"
            android:letterSpacing="0.12"
            android:textColor="#888888"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>
</LinearLayout>
