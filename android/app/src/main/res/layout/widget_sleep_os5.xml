<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing OS 5 skin: Geist Mono numerals, Geist labels, frosted panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_os5"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_mono"
        android:fontWeight="600"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:text="--" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist"
            android:letterSpacing="0.1"
            android:text="SLEEP SCORE"
            android:textAllCaps="true"
            android:textColor="#969696"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/geist"
            android:text="NO DATA"
            android:textColor="#C9C9C9"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_delta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_mono"
        android:textColor="#C9C9C9"
        android:textSize="14sp"
        android:text="" />
</LinearLayout>
