<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing OS 5 skin, MINIMALIST briefing: Geist throughout, frosted panel.
     Same IDs as widget_briefing: VU bar hero + one verdict word + date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_os5"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Glyph-LED verdict bar: 3 SQUARE segments (14dp, uniform size, 3dp
         gaps) in a 48dp column — the widget's focal point, sized for a
         1-cell (40dp) tall widget. Order top→bottom is green, yellow, red;
         BriefingWidgetProvider paints by level. -->
    <LinearLayout
        android:id="@+id/widget_vu_bar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_vu_green"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_vu_seg_dim" />

        <TextView
            android:id="@+id/widget_vu_yellow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_vu_seg_dim" />

        <TextView
            android:id="@+id/widget_vu_red"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/widget_vu_seg_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_briefing_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist"
            android:fontWeight="700"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />

        <TextView
            android:id="@+id/widget_briefing_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist"
            android:letterSpacing="0.12"
            android:textColor="#969696"
            android:textSize="9sp"
            android:text="" />
    </LinearLayout>
</LinearLayout>
