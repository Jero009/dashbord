<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing OS 5 widget material: dark translucent panel, soft hairline,
     bigger radius (28dp). Frost reads as depth, not decoration.
     Alpha ~55% so the launcher wallpaper visibly shows through — at 85%
     it read as an opaque dark tile (defeats the material). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#8C141414" />
    <corners android:radius="28dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
